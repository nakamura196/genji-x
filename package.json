{
  "name": "genji-x",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "snapshot": "node scripts/build-snapshot.mjs",
    "prebuild": "node scripts/build-snapshot.mjs && node scripts/build-tei-facets.mjs && node scripts/build-transactions.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "facets": "node scripts/build-tei-facets.mjs",
    "transactions": "node scripts/build-transactions.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "next": "^16.3.0",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.20",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.126.0"
  },
  "overrides": {
    "js-yaml": ">=4.3.1",
    "nanoid": ">=3.3.18",
    "@swc/helpers": "0.5.23"
  },
  "description": "校異源氏物語の帖ごとの目録。索引サーバを使わず、チェーンと IPFS から直接組み立てる。Ocean Market / Pontus-X Portal / Clio-X と同じ画面の系統。"
}
